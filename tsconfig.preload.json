{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": "./dist-electron/preload",
    "rootDir": "./src"
  },
  "include": ["src/preload/**/*.ts", "src/renderer/model/**/*.ts"],
  "exclude": ["src/renderer/model/figure-derivations.ts"]
}
